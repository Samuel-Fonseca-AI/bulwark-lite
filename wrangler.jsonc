{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bulwark-lite",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
